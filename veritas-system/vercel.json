{
  "buildCommand": "npm install --prefix frontend && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install --prefix backend",
  "functions": {
    "backend/api/admin/login.ts": {
      "runtime": "@vercel/node@3.0.0",
      "includeFiles": "backend/{db,services}/**"
    },
    "backend/api/admin/schedule.ts": {
      "runtime": "@vercel/node@3.0.0",
      "includeFiles": "backend/{db,services}/**"
    },
    "backend/api/admin/status.ts": {
      "runtime": "@vercel/node@3.0.0",
      "includeFiles": "backend/{db,services}/**"
    },
    "backend/api/referral/register.ts": {
      "runtime": "@vercel/node@3.0.0",
      "includeFiles": "backend/{db,services}/**"
    },
    "backend/api/referral/rewards.ts": {
      "runtime": "@vercel/node@3.0.0",
      "includeFiles": "backend/{db,services}/**"
    },
    "backend/api/referral/claim.ts": {
      "runtime": "@vercel/node@3.0.0",
      "includeFiles": "backend/{db,services}/**"
    },
    "backend/api/referral/generate.ts": {
      "runtime": "@vercel/node@3.0.0",
      "includeFiles": "backend/{db,services}/**"
    },
    "backend/api/feedback.ts": {
      "runtime": "@vercel/node@3.0.0",
      "includeFiles": "backend/{db,services}/**"
    },
    "backend/api/markets.ts": {
      "runtime": "@vercel/node@3.0.0",
      "includeFiles": "backend/{db,services}/**"
    },
    "backend/api/cron/publishMarkets.ts": {
      "runtime": "@vercel/node@3.0.0",
      "includeFiles": "backend/{db,services}/**"
    },
    "backend/api/cron/processReferralRewards.ts": {
      "runtime": "@vercel/node@3.0.0",
      "includeFiles": "backend/{db,services}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/login",
      "destination": "/backend/api/admin/login.ts"
    },
    {
      "source": "/api/admin/schedule",
      "destination": "/backend/api/admin/schedule.ts"
    },
    {
      "source": "/api/admin/status",
      "destination": "/backend/api/admin/status.ts"
    },
    {
      "source": "/api/referral/register",
      "destination": "/backend/api/referral/register.ts"
    },
    {
      "source": "/api/referral/rewards",
      "destination": "/backend/api/referral/rewards.ts"
    },
    {
      "source": "/api/referral/claim",
      "destination": "/backend/api/referral/claim.ts"
    },
    {
      "source": "/api/referral/generate",
      "destination": "/backend/api/referral/generate.ts"
    },
    {
      "source": "/api/feedback",
      "destination": "/backend/api/feedback.ts"
    },
    {
      "source": "/api/markets",
      "destination": "/backend/api/markets.ts"
    },
    {
      "source": "/api/cron/publishMarkets",
      "destination": "/backend/api/cron/publishMarkets.ts"
    },
    {
      "source": "/api/cron/processReferralRewards",
      "destination": "/backend/api/cron/processReferralRewards.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}