{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/$1"
    },
    {
      "src": "^/assets/(.*)",
      "dest": "/frontend/dist/assets/$1"
    },
    {
      "src": "^/favicon.svg",
      "dest": "/frontend/dist/favicon.svg"
    },
    {
      "src": ".*",
      "dest": "/frontend/dist/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/publishMarkets",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/processReferralRewards",
      "schedule": "0 0 * * *"
    }
  ]
}